{
  "name": "ecobite",
  "version": "1.0.0",
  "private": true,
  "description": "EcoBite - eco-friendly food delivery (MERN stack)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
