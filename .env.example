# ------------------------------------------------------------------
# EcoBite backend configuration
# Copy this file to `.env` in the project root and adjust the values.
# ------------------------------------------------------------------

# Port for the Express API
PORT=5000

# MongoDB connection string.
# Option A (local MongoDB):    mongodb://127.0.0.1:27017/ecobite
# Option B (MongoDB Atlas):    mongodb+srv://<user>:<password>@<cluster>/ecobite
MONGO_URI=mongodb://127.0.0.1:27017/ecobite

# Long random string used to sign JWTs. Replace with your own in production.
JWT_SECRET=dev-only-change-me-8f4c1c2a9b7e4d6f
JWT_EXPIRES_IN=7d

# Allowed browser origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Set to true to run an in-memory MongoDB (data resets on restart).
# Useful for a zero-install demo. For real persistence use MONGO_URI above.
USE_MEMORY_DB=false

# Set to true to insert demo data automatically when the database is empty.
AUTO_SEED=true

NODE_ENV=development
